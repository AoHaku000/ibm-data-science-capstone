import pandas as pd
import numpy as np

df = pd.read_csv('../datasets/dataset_part_1.csv')

# Replace missing PayloadMass with mean
mean_payload = df['PayloadMass'].mean()
df['PayloadMass'].replace(np.nan, mean_payload, inplace=True)

# Derive landing outcome class (1 = Success, 0 = Fail)
landing_outcomes = df['Outcome'].value_counts()
bad_outcomes = set(landing_outcomes.keys()[[1, 3, 5, 6, 7]])

landing_class = []
for outcome in df['Outcome']:
    if outcome in bad_outcomes:
        landing_class.append(0)
    else:
        landing_class.append(1)

df['Class'] = landing_class
df.to_csv('../datasets/dataset_part_2.csv', index=False)

# Create Dummy variables for One-Hot Encoding
features = df[['FlightNumber', 'PayloadMass', 'Orbit', 'LaunchSite', 'Flights', 'GridFins', 'Reused', 'Legs', 'LandingPad', 'Block', 'ReusedCount', 'Serial']]
features_one_hot = pd.get_dummies(features, columns=['Orbit', 'LaunchSite', 'LandingPad', 'Serial'])
features_one_hot = features_one_hot.astype('float64')

features_one_hot.to_csv('../datasets/dataset_part_3.csv', index=False)
