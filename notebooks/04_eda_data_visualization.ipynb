import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

df = pd.read_csv('../datasets/dataset_part_2.csv')

# Flight Number vs Launch Site
sns.catplot(y="LaunchSite", x="FlightNumber", hue="Class", data=df, aspect=3)
plt.xlabel("Flight Number", fontsize=15)
plt.ylabel("Launch Site", fontsize=15)
plt.title("Flight Number vs. Launch Site")
plt.savefig("flight_vs_site.png")
plt.show()

# Payload Mass vs Launch Site
sns.catplot(y="LaunchSite", x="PayloadMass", hue="Class", data=df, aspect=3)
plt.xlabel("Payload Mass (kg)", fontsize=15)
plt.ylabel("Launch Site", fontsize=15)
plt.title("Payload Mass vs. Launch Site")
plt.savefig("payload_vs_site.png")
plt.show()

# Success Rate by Orbit Type
orbit_success = df.groupby('Orbit')['Class'].mean().reset_index()
sns.barplot(x="Orbit", y="Class", data=orbit_success)
plt.xlabel("Orbit Type", fontsize=15)
plt.ylabel("Success Rate", fontsize=15)
plt.title("Success Rate by Orbit Type")
plt.savefig("orbit_success.png")
plt.show()

# Yearly Launch Success Trend
year = []
for i in df["Date"]:
    year.append(i.split("-")[0])
df['Year'] = year
sns.lineplot(x="Year", y="Class", data=df)
plt.xlabel("Year", fontsize=15)
plt.ylabel("Average Success Rate", fontsize=15)
plt.title("Launch Success Yearly Trend")
plt.savefig("yearly_trend.png")
plt.show()
