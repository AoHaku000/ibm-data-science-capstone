import sqlite3
import pandas as pd

con = sqlite3.connect("my_data1.db")
cur = con.cursor()

df = pd.read_csv("https://cf-courses-data.s3.us.cloud-object-storage.appdomain.cloud/IBM-DS0321EN-SkillsNetwork/labs/module_2/data/Spacex.csv")
df.to_sql("SPACEXTBL", con, if_exists='replace', index=False, method="multi")

# Query 1: Unique launch sites
q1 = pd.read_sql_query("SELECT DISTINCT Launch_Site FROM SPACEXTBL", con)
print(q1)

# Query 2: Total payload mass carried by NASA (CRS)
q2 = pd.read_sql_query("SELECT SUM(PAYLOAD_MASS__KG_) AS Total_NASA_Payload FROM SPACEXTBL WHERE Customer = 'NASA (CRS)'", con)
print(q2)

# Query 3: First successful ground pad landing date
q3 = pd.read_sql_query("SELECT MIN(Date) AS First_Success FROM SPACEXTBL WHERE Landing_Outcome = 'Success (ground pad)'", con)
print(q3)

# Query 4: Boosters carrying max payload mass
q4 = pd.read_sql_query("SELECT Booster_Version FROM SPACEXTBL WHERE PAYLOAD_MASS__KG_ = (SELECT MAX(PAYLOAD_MASS__KG_) FROM SPACEXTBL)", con)
print(q4)
