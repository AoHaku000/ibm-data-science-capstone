import folium
import pandas as pd
from folium.plugins import MarkerCluster, MousePosition
from math import sin, cos, sqrt, atan2, radians

spacex_df = pd.read_csv('../datasets/dataset_part_2.csv')

# Calculate Haversine Distance
def calculate_distance(lat1, lon1, lat2, lon2):
    R = 6373.0
    lat1, lon1, lat2, lon2 = map(radians, [lat1, lon1, lat2, lon2])
    dlon, dlat = lon2 - lon1, lat2 - lat1
    a = sin(dlat / 2)**2 + cos(lat1) * cos(lat2) * sin(dlon / 2)**2
    return R * 2 * atan2(sqrt(a), sqrt(1 - a))

nasa_coordinate = [29.55968, -95.08309]
site_map = folium.Map(location=nasa_coordinate, zoom_start=4)

# Add Marker Cluster
marker_cluster = MarkerCluster()
site_map.add_child(marker_cluster)

for index, record in spacex_df.iterrows():
    marker_color = 'green' if record['Class'] == 1 else 'red'
    marker = folium.Marker(
        location=[record['Latitude'], record['Longitude']],
        icon=folium.Icon(color='white', icon_color=marker_color),
        popup=record['LaunchSite']
    )
    marker_cluster.add_child(marker)

site_map.save("spacex_folium_map.html")
